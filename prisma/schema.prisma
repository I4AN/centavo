// Centavo — modelo de datos
// Decisión clave: todo monto se guarda como Int en centavos de COP.
// Nunca floats para dinero. De ahí el nombre del proyecto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoMovimiento {
  INGRESO
  GASTO
}

model Usuario {
  id             String           @id @default(cuid())
  correo         String           @unique
  nombre         String
  hashContrasena String
  createdAt      DateTime         @default(now())
  sesiones       Sesion[]
  movimientos    Movimiento[]
  presupuestos   Presupuesto[]
  salarios       SalarioMensual[]
}

model Sesion {
  token     String   @id
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  expiraEn  DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model Categoria {
  id           String         @id @default(cuid())
  nombre       String         @unique
  grupo        String
  tipo         TipoMovimiento
  movimientos  Movimiento[]
  presupuestos Presupuesto[]

  @@index([tipo, grupo])
}

model Movimiento {
  id            String         @id @default(cuid())
  tipo          TipoMovimiento
  montoCentavos Int
  fecha         DateTime       @db.Date
  nota          String?
  categoria     Categoria      @relation(fields: [categoriaId], references: [id])
  categoriaId   String
  usuario       Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String
  createdAt     DateTime       @default(now())

  @@index([usuarioId, fecha])
  @@index([categoriaId, fecha])
}

model Presupuesto {
  id            String    @id @default(cuid())
  mes           String // "YYYY-MM"
  montoCentavos Int
  categoria     Categoria @relation(fields: [categoriaId], references: [id])
  categoriaId   String
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String
  updatedAt     DateTime  @updatedAt

  @@unique([usuarioId, categoriaId, mes])
  @@index([usuarioId, mes])
}

model SalarioMensual {
  mes           String // "YYYY-MM"
  montoCentavos Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String
  updatedAt     DateTime @updatedAt

  @@id([usuarioId, mes])
}
